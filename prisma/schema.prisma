generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String?
  email        String        @unique
  password     String
  xp           Int           @default(0)
  level        Int           @default(1)
  age          Int?
  college      String?
  course       String?
  image        String?
  gameSessions GameSession[]
  feedbacks    Feedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model GameSession {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("Untitled Game")
  score        Int
  accuracy     Float
  timeSpent    Int
  notesContent String?
  mistakes     String?  // JSON stringified array of { question, correct }
  createdAt    DateTime @default(now())
}
